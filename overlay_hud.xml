<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Compact Floating Control Bar for Tiff -->
    <LinearLayout
        android:id="@+id/hudBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#EB14171D"
        androidandroid:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <TextView
            android:id="@+id/tvTiffBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="5dp"
            android:text="TIFF"
            android:textColor="#EC4899"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHudPoint"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#DB2777"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="Point"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHudDrive"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#2563EB"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="Drive"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHudTelegram"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#0284C7"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="TG"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHudMacros"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#0D9488"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="Macros"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHudMic"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#374151"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="Mic"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnHudQuiet"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#374151"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp"
            android:text="Voice"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnHudStop"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:backgroundTint="#DC2626"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:text="STOP"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Macros Drawer in HUD -->
    <LinearLayout
        android:id="@+id/panelMacrosDrawer"
        android:layout_width="310dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#F2181B22"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tiff's Macros &amp; App Intents"
                android:textColor="#F3F4F6"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCloseMacrosDrawer"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:backgroundTint="#374151"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="X"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hudMacrosContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- Expandable Prompt / Plan / Telegram Panel -->
    <LinearLayout
        android:id="@+id/panelInput"
        android:layout_width="315dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#F2181B22"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPanelTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ask Tiff where to click..."
            android:textColor="#F3F4F6"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etHudCommand"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="#262B36"
            android:hint="e.g. schedule this email"
            android:inputType="text"
            android:paddingHorizontal="10dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#9CA3AF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvPlanPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#111318"
            android:padding="8dp"
            android:textColor="#D1D5DB"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPanelSecondary"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="#0284C7"
                android:text="Bot Msg"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnPanelCancel"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#374151"
                android:text="Close"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPanelExecute"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#DB2777"
                android:text="Ask Tiff"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
