<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTelegramBack"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:backgroundTint="#2D3340"
                android:text="&lt; Back"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Telegram Hub &amp; Auto-Driver"
                android:textColor="#F3F4F6"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Use Tiff's Personal Telegram App Auto-Driver to message anyone in your Telegram contacts directly, or connect a Bot Token for remote commands."
            android:textColor="#9CA3AF"
            android:textSize="13sp" />

        <!-- Personal Telegram App Auto-Driver Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1A1D24"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Personal Telegram App Auto-Driver"
                android:textColor="#EC4899"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Opens your personal Telegram app, searches for any contact or @username, types your message, and optionally taps Send."
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cbAutoTapSend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:buttonTint="#EC4899"
                android:text="Auto-tap Send button (Uncheck to review draft before sending)"
                android:textColor="#F3F4F6"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Quick Test Auto-Driver"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etTestDriverRecipient"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="#262A34"
                android:hint="Contact name or @username (e.g. Saved Messages)"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7280"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etTestDriverMessage"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="#262A34"
                android:hint="Message text (e.g. Hey! Testing Tiff auto-driver)"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7280"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnRunTestDriver"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#EC4899"
                android:text="Drive Telegram App Now"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bot Configuration Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1A1D24"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Two-Way Bot Bridge (Optional)"
                android:textColor="#38BDF8"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Telegram Bot Token (@BotFather)"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etTelegramToken"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="#262A34"
                android:hint="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"
                android:inputType="textPassword"
                android:paddingHorizontal="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7280"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Your Default Chat ID"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etTelegramChatId"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="#262A34"
                    android:hint="e.g. 987654321"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#6B7280"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnDetectChatId"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#0284C7"
                    android:text="Auto-Detect"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbTelegramPolling"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="#38BDF8"
                android:text="Listen for incoming Telegram bot commands (/screen, /remember, chat)"
                android:textColor="#F3F4F6"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnSaveTelegram"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#2E9E6B"
                android:text="Save All Telegram Settings"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTestTelegram"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#374151"
                android:text="Send Test Bot Message"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Named Telegram Bot Contacts Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1A1D24"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Saved Bot Chat Shortcuts (Optional)"
                android:textColor="#38BDF8"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTgContactName"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="#262A34"
                android:hint="Contact Name"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7280"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etTgContactChatId"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="#262A34"
                android:hint="Numeric Chat ID"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7280"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnAddTgContact"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#0284C7"
                android:text="Save Bot Chat Shortcut"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/containerTgContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
